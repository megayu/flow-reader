{
  "name": "flow-reader",
  "private": true,
  "type": "module",
  "description": "Tauri desktop EPUB and TXT reader based on pacexy/flow",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest run",
    "test:integration": "pnpm build && playwright test",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:base": "pnpm test:unit && pnpm format:check && pnpm lint && pnpm typecheck",
    "check:extended": "pnpm --filter @flow/epubjs test && pnpm rust:format:check && pnpm rust:lint && pnpm rust:test && pnpm test:integration",
    "check": "pnpm check:base && pnpm build",
    "check:full": "pnpm check:base && pnpm check:extended",
    "check:release": "pnpm check:base && pnpm check:extended && pnpm tauri:build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features devtools",
    "tauri:build": "tauri build --no-bundle",
    "release:local": "node scripts/release-local.ts",
    "doctor": "npx react-doctor@latest -y",
    "doctor:lines": "npx react-doctor@latest --scope lines --base HEAD --no-score --verbose -y"
  },
  "lint-staged": {
    "*.{js,jsx,json,jsonc,css,ts,tsx,html}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@flow/epubjs": "workspace:*",
    "@github/mini-throttle": "2.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-colorful": "5.7.0",
    "react-dom": "19.2.7",
    "react-highlight-words": "0.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "valtio": "2.3.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-highlight-words": "0.20.1",
    "@vitejs/plugin-react": "6.0.4",
    "chokidar": "3.6.0",
    "husky": "7.0.4",
    "lint-staged": "12.3.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
