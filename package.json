{
  "name": "flow-reader",
  "private": true,
  "description": "Tauri desktop EPUB and TXT reader based on pacexy/flow",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev -p 7127",
    "build": "next build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features devtools",
    "tauri:build": "tauri build --no-bundle",
    "release:local": "node scripts/release-local.mjs",
    "analyze:turbopack": "next experimental-analyze --output",
    "lint": "eslint src locales scripts test .agents/skills next.config.js tailwind.config.js postcss.config.js eslint.config.mjs playwright.config.ts",
    "test:theme": "node test/theme-tokens.js",
    "test:reader-optimization": "node test/reader-optimization.js",
    "test:smoke": "node scripts/test-smoke.mjs",
    "check": "pnpm test:theme && pnpm test:reader-optimization && pnpm lint && pnpm build",
    "check:full": "pnpm check && pnpm test:smoke && pnpm --filter @flow/epubjs test && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:release": "pnpm check:full && pnpm tauri:build",
    "prepare": "husky install",
    "doctor": "npx react-doctor@latest -y",
    "doctor:lines": "npx react-doctor@latest --scope lines --base HEAD --no-score --verbose -y"
  },
  "lint-staged": {
    "*.{js,json,css,ts,tsx,md,mdx}": "prettier --write",
    "*.{yml,yaml}": "prettier --write",
    "{src,locales,test}/**/*.{js,ts,tsx}": "eslint --fix",
    "{scripts,.agents/skills}/**/*.mjs": "eslint --fix",
    "{next,tailwind,postcss}.config.js": "eslint --fix",
    "playwright.config.ts": "eslint --fix",
    "eslint.config.mjs": "eslint --fix"
  },
  "dependencies": {
    "@flow/epubjs": "workspace:*",
    "@github/mini-throttle": "2.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-colorful": "5.7.0",
    "react-dom": "19.2.7",
    "react-focus-lock": "2.13.7",
    "react-highlight-words": "0.21.0",
    "react-polymorphic-types": "2.0.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "valtio": "2.3.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-highlight-words": "0.20.1",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "husky": "7.0.4",
    "lint-staged": "12.3.7",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
