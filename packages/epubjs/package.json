{
  "name": "@flow/epubjs",
  "version": "0.3.93",
  "description": "Flow Reader's internal EPUB parser and renderer",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./navigation": {
      "types": "./types/navigation.d.ts",
      "import": "./src/navigation.js",
      "default": "./src/navigation.js"
    },
    "./packaging": {
      "types": "./types/packaging.d.ts",
      "import": "./src/packaging.js",
      "default": "./src/packaging.js"
    },
    "./rendition": {
      "types": "./types/rendition.ts",
      "import": "./types/rendition.ts",
      "default": "./types/rendition.ts"
    },
    "./request": {
      "types": "./types/utils/request.d.ts",
      "import": "./src/utils/request.js",
      "default": "./src/utils/request.js"
    },
    "./section": {
      "types": "./types/section.d.ts",
      "import": "./src/section.js",
      "default": "./src/section.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run && pnpm test:types",
    "test:types": "tsc -p types/tsconfig.json",
    "test:watch": "vitest"
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.10",
    "jszip": "^3.10.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "lodash": "^4.18.1"
  }
}
