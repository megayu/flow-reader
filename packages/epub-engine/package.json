{
  "name": "@flow/epub-engine",
  "version": "0.1.0",
  "description": "Flow Reader's internal EPUB parser and renderer",
  "exports": {
    ".": "./src/index.ts",
    "./navigation": "./src/navigation.ts",
    "./packaging": "./src/packaging.ts",
    "./rendition": "./src/public-rendition.ts",
    "./request": "./src/utils/request.ts",
    "./section": "./src/section.ts"
  },
  "scripts": {
    "test:browser": "vitest run",
    "test": "pnpm test:browser && pnpm typecheck",
    "test:ci": "pnpm test:browser --bail=1 && pnpm typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "jszip": "3.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "private": true
}
