{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Reader",
  "mainBinaryName": "Flow Reader",
  "version": "0.1.0",
  "identifier": "com.flow.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:7127",
    "beforeBuildCommand": "pnpm export",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flow Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB eBook",
        "mimeType": "application/epub+zip"
      }
    ]
  }
}
