{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Reader",
  "mainBinaryName": "Flow Reader",
  "version": "0.1.0",
  "identifier": "com.flow.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:7127",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flow Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["flow-reader"]
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "megayu",
    "copyright": "Copyright © 2026 megayu",
    "resources": {
      "../LICENSE": "licenses/Flow-AGPL-3.0.txt",
      "../packages/epubjs/license": "licenses/Epub.js-BSD-2-Clause.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "FlowReader.Epub",
        "description": "EPUB eBook",
        "mimeType": "application/epub+zip"
      }
    ]
  }
}
